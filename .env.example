# Copie este arquivo para .env e preencha os valores
# Caminho: fap\.env

# Credenciais do PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fap
DB_USER=postgres
DB_PASSWORD=sua_senha

# Personal Access Token do GitHub — essencial para a coleta (sem ele são só
# 60 req/hora da API e o TTFR não dá tempo de calcular; com token, 5.000/hora)
# https://github.com/settings/tokens -> token "classic" com permissão public_repo,
# ou fine-grained no repositório com Contents e Issues em leitura
GITHUB_TOKEN=coloque_seu_token_aqui

# Login OAuth com GitHub (opcional; sem isso vale o /login/dev)
# Crie um OAuth App em https://github.com/settings/developers
# Authorization callback URL: http://127.0.0.1:5000/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Chave de sessão do Flask (opcional; se vazia, uma chave aleatória é gerada
# a cada início e as sessões são invalidadas ao reiniciar o app)
SESSION_SECRET=

# Configuração da coleta
MESES_ANALISE=6

# Opcionais (defaults entre parênteses)
# MINERACAO_INTERVALO_DIAS=7   frequência da coleta automática, em dias
# DB_CONNECT_TIMEOUT=10        timeout de conexão com o banco, em segundos
# FAP_HOST=127.0.0.1           endereço do servidor waitress
# PORT=5000                    porta do servidor waitress
# FAP_SEM_AUTOCOLETA=1         não coleta nada no boot (usado pelos testes)
