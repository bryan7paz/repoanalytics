# Copie este arquivo para .env e preencha os valores
# Caminho: fap\.env

# Credenciais do PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fap
DB_USER=postgres
DB_PASSWORD=sua_senha

# Personal Access Token do GitHub - essencial para a coleta (sem ele sao so
# 60 req/hora da API e o TTFR nao da tempo de calcular; com token, 5.000/hora)
# https://github.com/settings/tokens -> token "classic" com permissao public_repo,
# ou fine-grained no repositorio com Contents e Issues em leitura
GITHUB_TOKEN=coloque_seu_token_aqui

# Login OAuth com GitHub - ja vem com as credenciais do OAuth App do projeto.
# Quem baixa o repositorio nao precisa criar nada: o botao "Entrar com GitHub"
# aparece assim que o setup.py gerar o .env a partir deste arquivo.
# Opcional: substitua pelas suas credenciais (github.com/settings/developers)
# Authorization callback URL: http://127.0.0.1:5000/callback
GITHUB_CLIENT_ID=Ov23liJLbJkagSPYyd2J
GITHUB_CLIENT_SECRET=a1f67be5ca5eeb3dacc686a8c586ba17d15a3e98

# Chave de sessao do Flask (opcional; se vazia, uma chave aleatoria e gerada
# a cada inicio e as sessoes sao invalidadas ao reiniciar o app)
SESSION_SECRET=

# Configuracao da coleta
MESES_ANALISE=6

# Opcionais (defaults entre parenteses)
# MINERACAO_INTERVALO_DIAS=7   frequencia da coleta automatica, em dias
# DB_CONNECT_TIMEOUT=10        timeout de conexao com o banco, em segundos
# FAP_HOST=127.0.0.1           endereco do servidor waitress
# PORT=5000                    porta do servidor waitress
# FAP_SEM_AUTOCOLETA=1         nao coleta nada no boot (usado pelos testes)
